@model Web.Models.Modelo_Productos.CategoriaModels.UpdateCategoriaModel

@{
    ViewData["Title"] = "Editar categoría";
}

<div class="crumb">
    <a asp-action="Index">Categorías</a>
    @await Html.PartialAsync("_Icon", "chevron-right")
    <span>Editar categoría</span>
</div>

<div class="page-header">
    <div>
        <h1>Editar categoría</h1>
        <p class="text-muted">Actualizá los datos de @Model.Nombre.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="form-wrap">
        <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
    </div>
}

<div class="form-wrap">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div class="fsec">
            <div class="stitle">Información general</div>
            <div class="fgrid">
                <div class="ffull">
                    <label asp-for="Nombre">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="ffull">
                    <label asp-for="Descripcion">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" />
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="factions">
            <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "back") Volver</a>
            <button type="submit" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "check") Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
