@model ProductApp.Aplication.Common.PagedResult<Web.Models.Modelo_Productos.ProductoModels.ProductoModel>

@{
    ViewData["Title"] = "Productos";
    var incluirInactivos = ViewBag.IncluirInactivos as bool? ?? false;
    var categorias = ViewBag.Categorias as List<Web.Models.Modelo_Productos.CategoriaModels.CategoriaModel>;
    var categoriaSeleccionada = ViewBag.CategoriaSeleccionada as string;
    var nombreBuscado = ViewBag.NombreBuscado as string;
    var categoriasActivas = Model.Items.Select(i => i.Categoria).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().Count();
}

<div class="page-header">
    <p class="text-muted">Catálogo activo · @Model.TotalCount productos en @categoriasActivas categorías.</p>
    <a asp-action="Create" class="btn-pa btn-pa-primary">
        @await Html.PartialAsync("_Icon", "add") Nuevo producto
    </a>
</div>

<div class="producto-filtros">
    <form asp-action="Buscar" method="get" class="producto-filtros-search">
        @await Html.PartialAsync("_Icon", "search")
        <input type="text" name="nombre" value="@nombreBuscado" class="producto-filtro-input" placeholder="Buscar por nombre o descripción…" />
    </form>

    <form asp-action="Buscar" method="get" class="producto-filtro-select">
        <select name="categoria" class="form-select" onchange="this.form.submit()">
            <option value="">Categoría: Todas</option>
            @if (categorias != null)
            {
                @foreach (var c in categorias)
                {
                    <option value="@c.Nombre" selected="@(c.Nombre == categoriaSeleccionada)">@c.Nombre</option>
                }
            }
        </select>
    </form>

    <div class="seg">
        <a asp-action="Index" asp-route-incluirInactivos="false" class="@(incluirInactivos ? "" : "on")">Activos</a>
        <a asp-action="Index" asp-route-incluirInactivos="true" class="@(incluirInactivos ? "on" : "")">Todos</a>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="surface-card empty-state">
        <div class="empty-icon">@await Html.PartialAsync("_Icon", "box")</div>
        <p class="empty-title">No hay productos para mostrar</p>
        <p class="empty-text">Probá con otro nombre o categoría, o creá el primer producto del catálogo.</p>
        <a asp-action="Create" class="btn-pa btn-pa-primary">
            @await Html.PartialAsync("_Icon", "add") Crear producto
        </a>
    </div>
}
else
{
<div class="producto-catalog-grid">
    @foreach (var item in Model.Items)
    {
        var activo = item.Estado == "Activo";
        var stockActual = item.StockActual ?? 0;
        var agotado = activo && stockActual <= 0;

        <a asp-action="Details" asp-route-id="@item.Id" class="producto-catalog-item">
            <div class="producto-catalog-shot @(agotado || !activo ? "off" : "")">
                @if (agotado)
                {
                    <span class="producto-catalog-badge agotado">Agotado</span>
                }
                else if (!activo)
                {
                    <span class="producto-catalog-badge inactivo">Inactivo</span>
                }

                @if (!string.IsNullOrWhiteSpace(item.ImagenUrl))
                {
                    <img src="@item.ImagenUrl" alt="@item.Nombre" loading="lazy" />
                }
                else
                {
                    @await Html.PartialAsync("_Icon", "image")
                }
            </div>

            <div class="producto-catalog-info">
                <span class="producto-catalog-name">@item.Nombre</span>
                <div class="producto-catalog-sub">@(item.Categoria ?? "Sin categoría") · Stock @stockActual</div>
                <div class="producto-catalog-price mono">@Html.Moneda(item.Precio)</div>
            </div>
        </a>
    }
</div>
}

@await Html.PartialAsync("_Pagination", new Web.Models.Common.PaginationInfo { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages })
