@model Web.Models.Modelo_Productos.ProductoModels.UpdateProductoModel

@{
    ViewData["Title"] = "Editar producto";
    var categorias = ViewBag.Categorias as List<Web.Models.Modelo_Productos.CategoriaModels.CategoriaModel>;
    var proveedores = ViewBag.Proveedores as List<Web.Models.Modelo_Proveedores.ProveedorModels.ProveedorModel>;
    var proveedorActual = ViewBag.ProveedorActual as string;

    // El select solo lista proveedores activos. Si el que tiene el producto ya está
    // dado de baja, se agrega como opción aparte para no perderlo al guardar.
    var proveedorDadoDeBaja = Model.ProveedorId.HasValue
        && (proveedores == null || !proveedores.Any(p => p.Id == Model.ProveedorId.Value));
    var imagenUrl = ViewBag.ImagenUrl as string;
}

<div class="crumb">
    <a asp-action="Index">Productos</a>
    <span>›</span>
    <span>Editar producto</span>
</div>

<div class="page-header">
    <div>
        <h1>Editar producto</h1>
        <p class="text-muted">Actualizá los datos de @Model.Nombre.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
}

<div class="form-wrap">
    <form asp-action="Edit" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="imagenActual" value="@imagenUrl" />

        <div class="fsec">
            <div class="stitle">Información general</div>
            <div class="fgrid">
                <div class="ffull">
                    <label asp-for="Nombre">Nombre del producto</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="ffull">
                    <label asp-for="Descripcion">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="CategoriaId">Categoría</label>
                    <select asp-for="CategoriaId" class="form-select">
                        <option value="">-- Selecciona una categoría --</option>
                        @if (categorias != null)
                        {
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="ProveedorId">Proveedor <span class="text-muted">(opcional)</span></label>
                    <select asp-for="ProveedorId" class="form-select">
                        <option value="">-- Sin proveedor --</option>
                        @if (proveedorDadoDeBaja)
                        {
                            <option value="@Model.ProveedorId">@(proveedorActual ?? "Proveedor actual") (dado de baja)</option>
                        }
                        @if (proveedores != null)
                        {
                            @foreach (var p in proveedores)
                            {
                                <option value="@p.Id">@p.Nombre</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ProveedorId" class="text-danger small"></span>
                </div>

                <div>
                    <label for="imagen">Imagen</label>
                    <div class="d-flex align-items-start gap-2">
                        <div class="imagen-preview" style="width:44px;height:44px;flex:none;border-radius:var(--radius-sm);">
                            @if (!string.IsNullOrWhiteSpace(imagenUrl))
                            {
                                <img src="@imagenUrl" alt="Imagen actual de @Model.Nombre" />
                            }
                            else
                            {
                                @await Html.PartialAsync("_Icon", "image")
                            }
                        </div>
                        <div class="flex-grow-1">
                            <input type="file" id="imagen" name="imagen" class="form-control" accept=".jpg,.jpeg,.png,.webp" data-max-mb="5" />
                            <div class="hint" style="font-size:.76rem;color:var(--color-muted);margin-top:5px;">Si no elegís nada, se conserva la actual.</div>
                            <span class="text-danger small d-block" data-imagen-error></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fsec">
            <div class="stitle">Precio</div>
            <div class="fgrid">
                <div>
                    <label asp-for="Precio">Precio de venta</label>
                    <div class="prefix">
                        <span>$</span>
                        <input asp-for="Precio" class="form-control mono" />
                    </div>
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Costo">Costo</label>
                    <div class="prefix">
                        <span>$</span>
                        <input asp-for="Costo" class="form-control mono" />
                    </div>
                    <span asp-validation-for="Costo" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="factions">
            <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "back") Volver</a>
            <button type="submit" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "check") Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
