@model Web.Models.Modelo_Notificaciones.NotificacionResumenModel

@{
    // Página a la que hay que volver después de marcar. Se manda explícita porque el
    // header Referer llega vacío (Referrer-Policy: no-referrer) y el controller solo
    // acepta rutas locales.
    var retorno = $"{Context.Request.Path}{Context.Request.QueryString}";

    string IconoPara(string tipo) => tipo switch
    {
        "CambioEstadoOrden" => "receipt",
        "StockBajo" => "alert",
        "PagoRegistrado" => "card",
        _ => "bell"
    };
}

<div class="notif-panel" id="notif-panel" role="menu">
    <div class="notif-panel-head">
        <span>Notificaciones</span>
        @if (Model.NoLeidas > 0)
        {
            <form asp-controller="Notificacion" asp-action="MarcarTodasLeidas" method="post">
                <input type="hidden" name="retorno" value="@retorno" />
                <button type="submit" class="notif-marcar-todas">Marcar todas como leídas</button>
            </form>
        }
    </div>

    @if (!Model.Recientes.Any())
    {
        <div class="notif-empty">
            @await Html.PartialAsync("_Icon", "inbox")
            <p>No tenés notificaciones todavía.</p>
        </div>
    }
    else
    {
        <div class="notif-list">
            @foreach (var n in Model.Recientes)
            {
                if (n.Leida)
                {
                    <div class="notif-item leida">
                        <span class="notif-item-icon">@await Html.PartialAsync("_Icon", IconoPara(n.Tipo))</span>
                        <span class="notif-item-body">
                            <span class="notif-item-msg">@n.Mensaje</span>
                            <span class="notif-item-fecha">@n.CreadoEn.ToString("dd/MM/yyyy HH:mm")</span>
                        </span>
                    </div>
                }
                else
                {
                    <form asp-controller="Notificacion" asp-action="MarcarLeida" asp-route-id="@n.Id" method="post">
                        <input type="hidden" name="retorno" value="@retorno" />
                        <button type="submit" class="notif-item">
                            <span class="notif-item-icon">@await Html.PartialAsync("_Icon", IconoPara(n.Tipo))</span>
                            <span class="notif-item-body">
                                <span class="notif-item-msg">@n.Mensaje</span>
                                <span class="notif-item-fecha">@n.CreadoEn.ToString("dd/MM/yyyy HH:mm")</span>
                            </span>
                            <span class="notif-dot" aria-hidden="true"></span>
                        </button>
                    </form>
                }
            }
        </div>
    }
</div>
