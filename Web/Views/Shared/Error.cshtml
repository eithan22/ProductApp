@model ErrorViewModel

@{
    ViewData["Title"] = "Algo salió mal";
}

<div class="surface-card">
    <div class="empty-state">

        <div class="empty-icon" style="background:var(--color-danger-soft); color:var(--color-danger);">
            @await Html.PartialAsync("_Icon", "alert")
        </div>

        <p class="empty-title">No pudimos completar la operación</p>

        <p class="empty-text">
            Ocurrió un problema al procesar tu solicitud. Podés volver al inicio e intentar de nuevo;
            si el problema sigue, avisale a un administrador.
        </p>

        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a asp-controller="Home" asp-action="Index" class="btn-pa btn-pa-primary">
                @await Html.PartialAsync("_Icon", "home") Volver al inicio
            </a>
            <a asp-controller="Orden" asp-action="Index" class="btn-pa btn-pa-outline">
                @await Html.PartialAsync("_Icon", "receipt") Ir a órdenes
            </a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted mono mt-4 mb-0" style="font-size:.76rem;">
                Referencia del error: @Model.RequestId
            </p>
        }

    </div>
</div>
