@model ProductApp.Aplication.Common.PagedResult<Web.Models.Modelo_Productos.InventarioModels.InventarioModel>

@{
    ViewData["Title"] = "Inventario";
    var soloBajo = ViewBag.SoloBajo as bool? ?? false;
    var totalBajo = ViewBag.TotalBajo as int? ?? 0;
    var proveedorId = ViewBag.ProveedorId as int?;
    var proveedores = ViewBag.Proveedores as List<Web.Models.Modelo_Proveedores.ProveedorModels.ProveedorModel>;
    var unidadesPagina = Model.Items.Sum(i => i.StockActual);
    var agotadosPagina = Model.Items.Count(i => i.StockActual <= 0);

    // En la vista de reposición el stock bajo se lee por proveedor: cada grupo es una
    // llamada distinta que hay que hacer. Los productos sin proveedor van al final.
    var gruposProveedor = Model.Items
        .GroupBy(i => new
        {
            i.ProveedorId,
            Nombre = string.IsNullOrWhiteSpace(i.Proveedor) ? "Sin proveedor asignado" : i.Proveedor
        })
        .OrderBy(g => g.Key.ProveedorId.HasValue ? 0 : 1)
        .ThenBy(g => g.Key.Nombre)
        .ToList();
}

<div class="page-header">
    <p class="text-muted">
        Existencias por producto. El mínimo de cada uno define cuándo entra en stock bajo.
    </p>
</div>

<div class="stat-strip mb-4">
    <div class="stat-cell">
        <div class="label">Productos con inventario</div>
        <div class="value">@Model.TotalCount</div>
        <div class="hint">Registrados en el catálogo</div>
    </div>
    <div class="stat-cell">
        <div class="label">Unidades listadas</div>
        <div class="value">@unidadesPagina</div>
        <div class="hint">Suma de lo que se ve en pantalla</div>
    </div>
    <div class="stat-cell">
        <div class="label">Stock bajo</div>
        <div class="value @(totalBajo > 0 ? "is-warn" : "")">@totalBajo</div>
        <div class="hint">En o por debajo del mínimo</div>
    </div>
    <div class="stat-cell">
        <div class="label">Agotados</div>
        <div class="value @(agotadosPagina > 0 ? "is-danger" : "")">@agotadosPagina</div>
        <div class="hint">Sin unidades en pantalla</div>
    </div>
</div>

@* El filtro se envía a la acción que se esté viendo para no perder el modo (todo / solo bajo). *@
<form asp-action="@(soloBajo ? "StockBajo" : "Index")" method="get" class="toolbar">
    <label class="visually-hidden" for="filtro-proveedor">Filtrar por proveedor</label>
    <select id="filtro-proveedor" name="proveedorId" class="form-select" style="width:240px;">
        <option value="" selected="@(!proveedorId.HasValue)">Proveedor: todos</option>
        @if (proveedores != null)
        {
            @foreach (var p in proveedores)
            {
                <option value="@p.Id" selected="@(proveedorId == p.Id)">@p.Nombre</option>
            }
        }
    </select>

    <div class="toolbar-group">
        <button type="submit" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "search") Filtrar</button>
        <a asp-action="@(soloBajo ? "StockBajo" : "Index")" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "reset") Limpiar</a>
    </div>

    <div class="seg">
        <a asp-action="Index" asp-route-proveedorId="@proveedorId" class="@(soloBajo ? "" : "on")">Todo el inventario</a>
        <a asp-action="StockBajo" asp-route-proveedorId="@proveedorId" class="@(soloBajo ? "on" : "")">Solo stock bajo</a>
    </div>
</form>

@if (!Model.Items.Any())
{
    <div class="surface-card empty-state">
        <div class="empty-icon">@await Html.PartialAsync("_Icon", soloBajo ? "check" : "layers")</div>
        <p class="empty-title">@(soloBajo ? "Todo el stock está en orden" : "No hay registros de inventario")</p>
        <p class="empty-text">
            @(soloBajo
                ? "Ningún producto está por debajo de su mínimo. Volvé a la vista completa para revisar el resto."
                : "El inventario se crea junto con cada producto. Cargá un producto para empezar a llevar existencias.")
        </p>
        @if (soloBajo)
        {
            <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "layers") Ver todo el inventario</a>
        }
        else
        {
            <a asp-controller="Producto" asp-action="Create" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "add") Nuevo producto</a>
        }
    </div>
}
else if (soloBajo)
{
    foreach (var grupo in gruposProveedor)
    {
        var delProveedor = grupo.OrderBy(i => i.Producto).ToList();
        var agotadosGrupo = delProveedor.Count(i => i.StockActual <= 0);

        <section class="day-group">
            <div class="day-label">
                <span class="d">@grupo.Key.Nombre</span>
                <span class="n">
                    @delProveedor.Count @(delProveedor.Count == 1 ? "producto" : "productos") por reponer@(agotadosGrupo > 0 ? $" · {agotadosGrupo} agotado" + (agotadosGrupo == 1 ? "" : "s") : "")
                </span>
            </div>

            <div class="surface-card">
                @foreach (var item in delProveedor)
                {
                    var bajo = item.StockActual <= item.StockMinimo;
                    var agotado = item.StockActual <= 0;
                    var cerca = !bajo && item.StockActual <= item.StockMinimo * 1.5;
                    var color = bajo ? "var(--color-danger)" : cerca ? "var(--color-warn)" : "var(--color-primary)";
                    var nivel = agotado || bajo ? "is-danger" : cerca ? "is-warn" : "";
                    var referencia = item.StockMinimo > 0 ? item.StockMinimo * 2 : Math.Max(item.StockActual, 1);
                    var ancho = Math.Min(100, (int)Math.Round((double)item.StockActual / referencia * 100));

                    <div class="inv-row">
                        <div>
                            <div class="ledger-name">@item.Producto</div>
                            <div class="text-muted" style="font-size:.78rem; margin-top:1px;">
                                Actualizado @item.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div>
                            <div class="inv-qty @nivel">
                                @item.StockActual <span class="sub">/ mín. @item.StockMinimo</span>
                            </div>
                            <div class="inv-bar" role="img"
                                 aria-label="@item.StockActual unidades, mínimo @item.StockMinimo">
                                <div class="inv-bar-fill" style="width:@(ancho)%; background:@color;"></div>
                            </div>
                        </div>

                        <div class="text-end">
                            <a asp-action="Movimiento" asp-route-productoId="@item.ProductoId"
                               class="btn-pa @(bajo ? "btn-pa-warn" : "btn-pa-outline")">
                                @await Html.PartialAsync("_Icon", "layers") Ajustar
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
}
else
{
    <div class="surface-card">
        <div class="list-head inv-head">
            <div>Producto</div>
            <div>Existencia</div>
            <div class="text-end">Acción</div>
        </div>

        @foreach (var item in Model.Items)
        {
            var bajo = item.StockActual <= item.StockMinimo;
            var agotado = item.StockActual <= 0;
            var cerca = !bajo && item.StockActual <= item.StockMinimo * 1.5;
            var color = bajo ? "var(--color-danger)" : cerca ? "var(--color-warn)" : "var(--color-primary)";
            var nivel = agotado || bajo ? "is-danger" : cerca ? "is-warn" : "";
            var referencia = item.StockMinimo > 0 ? item.StockMinimo * 2 : Math.Max(item.StockActual, 1);
            var ancho = Math.Min(100, (int)Math.Round((double)item.StockActual / referencia * 100));

            <div class="inv-row">
                <div>
                    <div class="ledger-name">@item.Producto</div>
                    <div class="text-muted" style="font-size:.78rem; margin-top:1px;">
                        Actualizado @item.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div>
                    <div class="inv-qty @nivel">
                        @item.StockActual <span class="sub">/ mín. @item.StockMinimo</span>
                    </div>
                    <div class="inv-bar" role="img"
                         aria-label="@item.StockActual unidades, mínimo @item.StockMinimo">
                        <div class="inv-bar-fill" style="width:@(ancho)%; background:@color;"></div>
                    </div>
                </div>

                <div class="text-end">
                    <a asp-action="Movimiento" asp-route-productoId="@item.ProductoId"
                       class="btn-pa @(bajo ? "btn-pa-warn" : "btn-pa-outline")">
                        @await Html.PartialAsync("_Icon", "layers") Ajustar
                    </a>
                </div>
            </div>
        }
    </div>
}

@if (!soloBajo)
{
    @await Html.PartialAsync("_Pagination", new Web.Models.Common.PaginationInfo { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages })
}
