@model Web.Models.Modelo_Ventas.OrdenModels.CreateOrdenModel

@{
    ViewData["Title"] = "Nueva orden";
    var clientes = ViewBag.Clientes as List<Web.Models.ClienteModels.ClienteModel>;
}

<div class="crumb">
    <a asp-action="Index">Órdenes</a>
    <span>›</span>
    <span>Nueva orden</span>
</div>

<div class="page-header">
    <div>
        <h1>Nueva orden</h1>
        <p class="text-muted">Seleccioná el cliente para iniciar la orden. Los productos se agregan en el siguiente paso.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
}

<div class="form-wrap">
    <form asp-action="Create">
        <div class="fsec">
            <div class="stitle">Cliente</div>
            <div class="fgrid">
                <div class="ffull">
                    <label asp-for="ClienteId">Cliente</label>
                    <select asp-for="ClienteId" class="form-select">
                        <option value="">-- Selecciona un cliente --</option>
                        @if (clientes != null)
                        {
                            @foreach (var c in clientes)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="ClienteId" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="factions">
            <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "back") Volver</a>
            <button type="submit" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "check") Crear orden</button>
        </div>
    </form>
</div>
