@model Web.Models.Modelo_Ventas.OrdenModels.OrdenModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = $"Orden #{Model.Id}";
    var detalles = ViewBag.Detalles as List<Web.Models.Modelo_Ventas.DetalleOrdenModels.DetalleOrdenModel> ?? new();
    var productos = ViewBag.Productos as List<Web.Models.Modelo_Productos.ProductoModels.ProductoModel> ?? new();
    var pagos = ViewBag.Pagos as List<Web.Models.Modelo_Ventas.PagoModels.PagoModel> ?? new();
    var saldoPendiente = ViewBag.SaldoPendiente as decimal? ?? 0;
    var monedaCodigo = Context.Session.GetString("MONEDA");

    // El valor que viaja al backend es el nombre del enum; el texto es solo
    // para leerlo en pantalla.
    var metodosPago = new (string Valor, string Texto)[]
    {
        ("Efectivo", "Efectivo"),
        ("TarjetaCredito", "Tarjeta de crédito"),
        ("TarjetaDebito", "Tarjeta de débito"),
        ("TransferenciaBancaria", "Transferencia bancaria"),
        ("PayPal", "PayPal")
    };

    string TextoMetodo(string valor) =>
        metodosPago.FirstOrDefault(m => m.Valor == valor).Texto ?? valor;

    // "Pendiente" en Pago.EstadoPago no significa "sin confirmar": el dinero ya entró,
    // solo indica que ese pago no saldó la orden todavía (ver M14). Mismo criterio de
    // lenguaje que ya usa Pago/Index.cshtml, para no mostrar el enum crudo acá.
    string TextoEstadoPago(string estado) =>
        string.Equals(estado, "Completado", StringComparison.OrdinalIgnoreCase) ? "Saldó la orden" : "Abono registrado";

    var transiciones = new Dictionary<string, string[]>
    {
        ["Pendiente"] = Array.Empty<string>(),
        ["Procesada"] = Array.Empty<string>(),
        ["Pagada"] = new[] { "Entregada" },
        ["Entregada"] = Array.Empty<string>(),
        ["Cancelada"] = Array.Empty<string>()
    };
    var puedeConfirmar = Model.Estado == "Pendiente";
    var puedeCancelar = Model.Estado == "Pendiente" || Model.Estado == "Procesada";
    var siguientesEstados = transiciones.TryGetValue(Model.Estado, out var t) ? t : Array.Empty<string>();
    var puedeRegistrarPago = (Model.Estado == "Pendiente" || Model.Estado == "Procesada") && saldoPendiente > 0;
    // La API sirve la factura para Pagada y Entregada; en el resto de estados
    // todavía no existe el PDF y el botón no debe aparecer.
    var puedeDescargarFactura = Model.Estado == "Pagada" || Model.Estado == "Entregada";

    var cancelada = Model.Estado == "Cancelada";
    var pasos = new[] { "Pendiente", "Procesada", "Pagada", "Entregada" };
    var pasoActual = Array.IndexOf(pasos, Model.Estado);

    var pagado = pagos.Sum(p => p.Monto);
    var avancePago = Model.Total > 0 ? (int)Math.Round(Math.Min(100, pagado / Model.Total * 100)) : 0;
    var unidades = detalles.Sum(d => d.Cantidad);
    var estadoClase = Model.Estado.ToLower();
}

<div class="crumb">
    <a asp-action="Index">Órdenes</a>
    @await Html.PartialAsync("_Icon", "chevron-right")
    <span>#@Model.Id</span>
</div>

<div class="page-header">
    <p class="text-muted">@Model.NombreCliente &middot; @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>

    <div class="page-header-actions">
        <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "back") Volver</a>

        @if (puedeDescargarFactura)
        {
            <a asp-action="DescargarFactura" asp-route-id="@Model.Id"
               target="_blank" rel="noopener"
               class="btn-pa btn-pa-outline">
                @await Html.PartialAsync("_Icon", "invoice") Descargar factura
                <span class="visually-hidden">(se abre en una pestaña nueva)</span>
            </a>
        }

        @foreach (var estado in siguientesEstados)
        {
            <form asp-action="CambiarEstado" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="nuevoEstado" value="@estado" />
                <button type="submit" class="btn-pa btn-pa-outline">
                    @await Html.PartialAsync("_Icon", "package") Marcar @estado.ToLower()
                </button>
            </form>
        }

        @if (puedeConfirmar)
        {
            <form asp-action="Confirmar" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-pa btn-pa-primary">
                    @await Html.PartialAsync("_Icon", "check") Confirmar orden
                </button>
            </form>
        }

        @if (puedeCancelar)
        {
            <form asp-action="Cancelar" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-pa btn-pa-danger">
                    @await Html.PartialAsync("_Icon", "x") Cancelar orden
                </button>
            </form>
        }
    </div>
</div>

@if (cancelada)
{
    <div class="surface-card p-4 mb-3 d-flex align-items-center gap-3 flex-wrap">
        <span class="orden-thumb e-cancelada" aria-hidden="true">@await Html.PartialAsync("_Icon", "x-circle")</span>
        <div>
            <div style="font-weight:700;">Esta orden fue cancelada</div>
            <div class="text-muted" style="font-size:.85rem;">
                No avanza de estado ni descuenta stock. Queda en el historial como registro.
            </div>
        </div>
        <span class="estado-pill estado-cancelada ms-auto">@Model.Estado</span>
    </div>
}
else
{
    <div class="surface-card p-4 mb-3">
        <div class="estado-stepper">
            @for (var i = 0; i < pasos.Length; i++)
            {
                var hecho = pasoActual > i;
                var actual = pasoActual == i;
                var clase = hecho ? "done" : actual ? "now" : "";

                if (i > 0)
                {
                    <div class="step-link @(pasoActual >= i ? "done" : "")"></div>
                }

                <div class="step @clase">
                    <div class="step-dot" aria-hidden="true">
                        @if (hecho)
                        {
                            @await Html.PartialAsync("_Icon", "tick")
                        }
                        else
                        {
                            @(i + 1)
                        }
                    </div>
                    <div class="step-lbl">@pasos[i]</div>
                </div>
            }
        </div>
        <p class="visually-hidden">Estado actual de la orden: @Model.Estado.</p>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">

        <div class="surface-card p-4 mb-3">
            <div class="ctitle">Datos de la orden</div>
            <div class="info-grid">
                <div>
                    <div class="l">Cliente</div>
                    <div class="v">@Model.NombreCliente</div>
                </div>
                <div>
                    <div class="l">Fecha</div>
                    <div class="v">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div>
                    <div class="l">Número de orden</div>
                    <div class="v mono">#@Model.Id</div>
                </div>
                <div>
                    <div class="l">Estado</div>
                    <div class="v"><span class="estado-pill estado-@estadoClase">@Model.Estado</span></div>
                </div>
            </div>
        </div>

        <div class="surface-card p-4 mb-3">
            <div class="ctitle">Productos</div>

            @if (!detalles.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">@await Html.PartialAsync("_Icon", "box")</div>
                    <p class="empty-title">La orden todavía está vacía</p>
                    <p class="empty-text">Agregá al menos un producto abajo para poder confirmarla y cobrarla.</p>
                </div>
            }
            else
            {
                <div class="tabla-scroll" tabindex="0" role="region" aria-label="Productos de la orden">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="text-muted" style="font-size:.78rem;">
                                <th scope="col">Producto</th>
                                <th scope="col">Cantidad</th>
                                <th scope="col" class="text-end">Precio unitario</th>
                                <th scope="col" class="text-end">Subtotal</th>
                                <th scope="col" class="text-end">Quitar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in detalles)
                            {
                                <tr>
                                    <td style="font-weight:600;">@d.Producto</td>
                                    <td style="max-width:140px;">
                                        <form asp-action="ActualizarCantidad" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="detalleId" value="@d.ID" />
                                            <input type="hidden" name="ordenId" value="@Model.Id" />
                                            <label class="visually-hidden" for="cant-@d.ID">Cantidad de @d.Producto</label>
                                            <input type="number" id="cant-@d.ID" name="cantidad" value="@d.Cantidad" min="1"
                                                   class="form-control form-control-sm mono" />
                                            <button type="submit" class="icon-btn" title="Actualizar cantidad de @d.Producto">
                                                @await Html.PartialAsync("_Icon", "check")
                                            </button>
                                        </form>
                                    </td>
                                    <td class="mono text-end">@Html.Moneda(d.PrecioUnitario)</td>
                                    <td class="mono text-end" style="font-weight:700;">@Html.Moneda(d.Subtotal)</td>
                                    <td class="text-end">
                                        <form asp-action="EliminarProducto" method="post">
                                            <input type="hidden" name="detalleId" value="@d.ID" />
                                            <input type="hidden" name="ordenId" value="@Model.Id" />
                                            <button type="submit" class="icon-btn danger" title="Quitar @d.Producto de la orden">
                                                @await Html.PartialAsync("_Icon", "trash")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="tot-row text-muted">
                    <div>@detalles.Count @(detalles.Count == 1 ? "línea" : "líneas") &middot; @unidades @(unidades == 1 ? "unidad" : "unidades")</div>
                </div>
                <div class="tot-row grand">
                    <div>Total</div>
                    <div class="mono">@Html.Moneda(Model.Total)</div>
                </div>
            }
        </div>

        <div class="surface-card p-4">
            <div class="ctitle">Agregar producto</div>
            <form asp-action="AgregarProducto" method="post" class="row g-2">
                <input type="hidden" name="ordenId" value="@Model.Id" />
                <div class="col-md-6">
                    <label class="visually-hidden" for="agregar-producto">Producto</label>
                    <select id="agregar-producto" name="productId" class="form-select" required>
                        <option value="">Elegí un producto…</option>
                        @foreach (var p in productos)
                        {
                            <option value="@p.Id">@p.Nombre (@Html.Moneda(p.Precio))</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="visually-hidden" for="agregar-cantidad">Cantidad</label>
                    <input type="number" id="agregar-cantidad" name="cantidad" min="1"
                           class="form-control mono" placeholder="Cantidad" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn-pa btn-pa-primary w-100 justify-content-center">
                        @await Html.PartialAsync("_Icon", "add") Agregar
                    </button>
                </div>
            </form>
        </div>

    </div>

    <div class="col-lg-4">
        <div class="surface-card p-4">

            <div class="ctitle">@(saldoPendiente > 0 ? "Saldo pendiente" : "Saldo")</div>
            <div class="pay-total @(saldoPendiente > 0 ? "is-warn" : "is-ok")">@Html.Moneda(saldoPendiente)</div>
            <div class="pay-sub">@Html.Moneda(pagado) pagados de @Html.Moneda(Model.Total)</div>

            <div class="pay-bar" role="img" aria-label="@avancePago% de la orden cobrado">
                <div class="pay-bar-fill" style="width:@(avancePago)%"></div>
            </div>

            @if (!pagos.Any())
            {
                <p class="text-muted" style="font-size:.85rem;">
                    Todavía no se registró ningún pago para esta orden.
                </p>
            }
            else
            {
                foreach (var p in pagos)
                {
                    <div class="pay-row">
                        <div>
                            <div class="m">@TextoMetodo(p.MetodoPago)</div>
                            <div class="d">@p.FechaPago.ToString("dd/MM/yyyy HH:mm") &middot; @TextoEstadoPago(p.EstadoPago)</div>
                        </div>
                        <div class="amt">@Html.Moneda(p.Monto)</div>
                    </div>
                }
            }

            @if (saldoPendiente <= 0 && pagos.Any())
            {
                <div class="pay-done">
                    @await Html.PartialAsync("_Icon", "tick")
                    <div>
                        <div class="t">La orden quedó saldada</div>
                        <div class="d">Pasó a @Model.Estado y el stock de los productos ya se descontó.</div>
                    </div>
                </div>
            }

            @if (puedeRegistrarPago)
            {
                <form asp-action="RegistrarPago" method="post" style="margin-top:18px;">
                    <input type="hidden" name="ordenId" value="@Model.Id" />

                    <div class="ffull mb-3">
                        <label for="pago-monto">Monto a pagar</label>
                        @if (!string.IsNullOrWhiteSpace(monedaCodigo))
                        {
                            <div class="prefix">
                                <span>@monedaCodigo</span>
                                <input type="number" id="pago-monto" name="monto" step="0.01" min="0.01"
                                       max="@saldoPendiente" value="@saldoPendiente"
                                       class="form-control mono" required />
                            </div>
                        }
                        else
                        {
                            <input type="number" id="pago-monto" name="monto" step="0.01" min="0.01"
                                   max="@saldoPendiente" value="@saldoPendiente"
                                   class="form-control mono" required />
                        }
                        <div class="text-muted" style="font-size:.76rem; margin-top:5px;">
                            Se admiten pagos parciales. Al cubrir el saldo completo la orden pasa a Pagada
                            y se descuenta el stock.
                        </div>
                    </div>

                    <div class="ffull mb-3">
                        <label for="pago-metodo">Método de pago</label>
                        <select id="pago-metodo" name="metodoPago" class="form-select" required>
                            <option value="">Elegí un método…</option>
                            @foreach (var m in metodosPago)
                            {
                                <option value="@m.Valor">@m.Texto</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn-pa btn-pa-primary w-100 justify-content-center">
                        @await Html.PartialAsync("_Icon", "card") Registrar pago
                    </button>
                </form>
            }

        </div>
    </div>
</div>
