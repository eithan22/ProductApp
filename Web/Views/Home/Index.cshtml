@model Web.Models.HomeDashboardModel

@{
    ViewData["Title"] = "Inicio";

    var labelsSemana = System.Text.Json.JsonSerializer.Serialize(
        Model.VentasSemana.Select(v => v.Fecha.ToString("ddd dd")));
    var dataSemana = System.Text.Json.JsonSerializer.Serialize(
        Model.VentasSemana.Select(v => v.Total));
}

<div class="page-header">
    <p class="text-muted">
        Hola@(string.IsNullOrWhiteSpace(Model.Nombre) ? "" : $", {Model.Nombre}") — este es el resumen de hoy.
    </p>

    <div class="page-header-actions">
        <a asp-controller="Producto" asp-action="Create" class="btn-pa btn-pa-outline">
            @await Html.PartialAsync("_Icon", "add") Producto
        </a>
        <a asp-controller="Orden" asp-action="Create" class="btn-pa btn-pa-primary">
            @await Html.PartialAsync("_Icon", "add") Orden
        </a>
        <a asp-controller="Cliente" asp-action="Create" class="btn-pa btn-pa-outline">
            @await Html.PartialAsync("_Icon", "add") Cliente
        </a>
    </div>
</div>

@if (Model.HuboErrores)
{
    <div class="pa-alerts">
        <div class="alert fade show pa-alert pa-alert-warn" role="alert">
            @await Html.PartialAsync("_Icon", "alert")
            <span class="flex-grow-1">
                Algunos datos no se pudieron cargar y se muestran como &laquo;&mdash;&raquo;. Recargá la página para reintentar.
            </span>
        </div>
    </div>
}

<div class="stat-strip mb-4">

    @if (Model.EsAdministrador)
    {
        <div class="stat-cell">
            <div class="label">Ingresos hoy</div>
            <div class="value">@(Model.IngresosHoy.HasValue ? Html.Moneda(Model.IngresosHoy.Value) : "—")</div>
            <div class="hint">Pagos registrados hoy</div>
        </div>
    }

    <div class="stat-cell">
        <div class="label">Órdenes pendientes</div>
        <div class="value @(Model.OrdenesPendientes > 0 ? "is-warn" : "")">
            @(Model.OrdenesPendientes?.ToString() ?? "—")
        </div>
        <div class="hint">Esperan confirmación</div>
    </div>

    <div class="stat-cell">
        <div class="label">Stock bajo</div>
        <div class="value @(Model.ProductosStockBajo > 0 ? "is-danger" : "")">
            @(Model.ProductosStockBajo?.ToString() ?? "—")
        </div>
        <div class="hint">Productos bajo el mínimo</div>
    </div>

    <div class="stat-cell">
        <div class="label">Clientes activos</div>
        <div class="value">@(Model.ClientesActivos?.ToString() ?? "—")</div>
        <div class="hint">Registrados y habilitados</div>
    </div>

</div>

<div class="row g-3 mb-4">

    @if (Model.EsAdministrador)
    {
        <div class="col-lg-7">
            <div class="surface-card p-3 h-100">
                <div class="ledger-name mb-3">Ventas de los últimos 7 días</div>

                @if (Model.VentasSemana.Any(v => v.Total > 0))
                {
                    <canvas id="chartSemana" height="150"></canvas>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">@await Html.PartialAsync("_Icon", "chart")</div>
                        <p class="empty-title">Todavía no hay ventas esta semana</p>
                        <p class="empty-text">Cuando registres pagos, el resumen semanal aparece acá.</p>
                    </div>
                }
            </div>
        </div>
    }

    <div class="@(Model.EsAdministrador ? "col-lg-5" : "col-12")">
        <div class="surface-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <span class="ledger-name">Órdenes recientes</span>
                <a asp-controller="Orden" asp-action="Index" class="btn-pa btn-pa-outline">Ver todas</a>
            </div>

            @if (!Model.OrdenesRecientes.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">@await Html.PartialAsync("_Icon", "receipt")</div>
                    <p class="empty-title">Sin órdenes todavía</p>
                    <p class="empty-text">Creá la primera orden para empezar a vender.</p>
                    <a asp-controller="Orden" asp-action="Create" class="btn-pa btn-pa-primary">
                        @await Html.PartialAsync("_Icon", "add") Nueva orden
                    </a>
                </div>
            }
            else
            {
                @foreach (var o in Model.OrdenesRecientes)
                {
                    <a class="ledger-row text-decoration-none text-reset"
                       asp-controller="Orden" asp-action="Details" asp-route-id="@o.Id">

                        <div class="ledger-body">
                            <div class="ledger-name">Orden #@o.Id &middot; @o.NombreCliente</div>
                            <div class="ledger-desc">@o.Fecha.ToString("dd/MM/yyyy")</div>
                        </div>

                        <div class="ledger-meta">
                            <span class="mono" style="font-weight:700;">@Html.Moneda(o.Total)</span>
                            <span class="estado-pill estado-@o.Estado.ToLower()">@o.Estado</span>
                        </div>
                    </a>
                }
            }
        </div>
    </div>

</div>

<div class="surface-card p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <span class="ledger-name">Alertas de inventario</span>
        <a asp-controller="Inventario" asp-action="StockBajo" class="btn-pa btn-pa-outline">Ver inventario</a>
    </div>

    @if (!Model.AlertasStock.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">@await Html.PartialAsync("_Icon", "check")</div>
            <p class="empty-title">Todo el stock está en orden</p>
            <p class="empty-text">Ningún producto está por debajo de su mínimo.</p>
        </div>
    }
    else
    {
        @foreach (var i in Model.AlertasStock)
        {
            <div class="ledger-row">
                <div class="ledger-body">
                    <div class="ledger-name">@i.Producto</div>
                    <div class="ledger-desc mono">
                        @i.StockActual en stock &middot; mínimo @i.StockMinimo
                    </div>
                </div>
                <div class="ledger-meta">
                    <span class="estado-pill estado-cancelada">Stock bajo</span>
                    <a asp-controller="Inventario" asp-action="Movimiento"
                       asp-route-productoId="@i.ProductoId" class="btn-pa btn-pa-warn">
                        @await Html.PartialAsync("_Icon", "layers") Reponer
                    </a>
                </div>
            </div>
        }
    }
</div>

<div class="row g-3">

    @if (Model.EsAdministrador)
    {
        <div class="col-lg-7">
            <div class="surface-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <span class="ledger-name">Top productos &middot; últimos 7 días</span>
                    <a asp-controller="Reporte" asp-action="ProductosMasVendidos"
                       asp-route-desde="@Model.RangoDesde.ToString("yyyy-MM-dd")"
                       asp-route-hasta="@Model.RangoHasta.ToString("yyyy-MM-dd")"
                       asp-route-top="10"
                       class="btn-pa btn-pa-outline">Ver reporte</a>
                </div>

                @if (!Model.TopProductos.Any())
                {
                    <div class="empty-state">
                        <div class="empty-icon">@await Html.PartialAsync("_Icon", "box")</div>
                        <p class="empty-title">Sin productos vendidos aún</p>
                        <p class="empty-text">El ranking se arma con las órdenes de los últimos 7 días.</p>
                    </div>
                }
                else
                {
                    @* el primero marca el 100%: cada barra se lee contra el líder de la semana *@
                    var maxVendido = Model.TopProductos.Max(p => p.CantidadVendida);

                    <div class="rank-list">
                        @{ var posicion = 0; }
                        @foreach (var p in Model.TopProductos)
                        {
                            posicion++;
                            var ancho = maxVendido > 0
                                ? (int)Math.Round((double)p.CantidadVendida / maxVendido * 100)
                                : 0;

                            <div class="rank-row">
                                <div class="rank-pos">@posicion</div>

                                <div class="rank-main">
                                    <div class="rank-name" title="@p.NombreProducto">@p.NombreProducto</div>
                                    @* la cifra ya está en texto al lado: la barra no se anuncia dos veces *@
                                    <div class="inv-bar" aria-hidden="true">
                                        <div class="inv-bar-fill"
                                             style="width:@(ancho)%; background:var(--color-primary);"></div>
                                    </div>
                                </div>

                                <div class="rank-value">@p.CantidadVendida uds</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="@(Model.EsAdministrador ? "col-lg-5" : "col-12")">
        <div class="surface-card p-3 h-100">
            <div class="ledger-name mb-3">Accesos rápidos</div>

            <div class="quick-links">
                <a class="quick-link" asp-controller="Producto" asp-action="Index">
                    @await Html.PartialAsync("_Icon", "box")
                    <span class="quick-label">Productos</span>
                </a>
                <a class="quick-link" asp-controller="Inventario" asp-action="Index">
                    @await Html.PartialAsync("_Icon", "layers")
                    <span class="quick-label">Inventario</span>
                </a>
                <a class="quick-link" asp-controller="Orden" asp-action="Index">
                    @await Html.PartialAsync("_Icon", "receipt")
                    <span class="quick-label">Órdenes</span>
                </a>
                <a class="quick-link" asp-controller="Reporte" asp-action="Index">
                    @await Html.PartialAsync("_Icon", "chart")
                    <span class="quick-label">Reportes</span>
                </a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @if (Model.EsAdministrador)
    {
        <script>
            const semanaLabels = @Html.Raw(labelsSemana);
            const semanaData = @Html.Raw(dataSemana);
            const lienzoSemana = document.getElementById('chartSemana');

            if (lienzoSemana && semanaLabels.length > 0) {
                new Chart(lienzoSemana, {
                    type: 'bar',
                    data: {
                        labels: semanaLabels,
                        datasets: [{
                            label: 'Total vendido',
                            data: semanaData,
                            backgroundColor: '#14503F',
                            borderRadius: 4,
                            maxBarThickness: 38
                        }]
                    },
                    options: {
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, grid: { color: '#E3E5E8' } },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }
        </script>
    }
}
