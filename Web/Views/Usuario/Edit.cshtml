@model Web.Models.Modelo_Usuarios.UsuarioModels.UpdateUsuarioModel
@using ProductApp.Domian.Common.Enums.EnumsUsuario

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="crumb">
    <a asp-action="Index">Usuarios</a>
    @await Html.PartialAsync("_Icon", "chevron-right")
    <span>Editar usuario</span>
</div>

<div class="page-header">
    <div>
        <h1>Editar usuario</h1>
        <p class="text-muted">
            Actualizá los datos de @Model.Nombre. La contraseña se cambia desde
            <a asp-action="ResetearPassword" asp-route-id="@Model.Id">Resetear contraseña</a>.
        </p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="form-wrap">
        <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
    </div>
}

<div class="form-wrap">
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />

        <div class="fsec">
            <div class="stitle">Datos personales</div>
            <div class="fgrid">
                <div>
                    <label asp-for="Nombre">Nombre completo</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Email">Correo electrónico</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="FechaNacimiento">Fecha de nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="fsec">
            <div class="stitle">Acceso</div>
            <div class="fgrid">
                <div>
                    <label asp-for="UserName">Nombre de usuario</label>
                    <input asp-for="UserName" class="form-control mono" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="fsec">
            <div class="stitle">Rol</div>
            <div class="role-opts">
                <label class="role-opt">
                    <input asp-for="RolUsuario" type="radio" value="@RolUsuario.Vendedor" />
                    <div class="t">Vendedor</div>
                    <div class="d">Gestiona órdenes, pagos y clientes.</div>
                </label>
                <label class="role-opt">
                    <input asp-for="RolUsuario" type="radio" value="@RolUsuario.Administrador" />
                    <div class="t">Administrador</div>
                    <div class="d">Acceso total, incluidos usuarios, reportes y configuración.</div>
                </label>
            </div>
            <span asp-validation-for="RolUsuario" class="text-danger small"></span>
        </div>

        <div class="factions">
            <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "back") Volver</a>
            <button type="submit" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "check") Guardar cambios</button>
        </div>
    </form>
</div>
