@using ProductApp.Domian.Common.Legal
@model Web.Models.Modelo_Usuarios.UsuarioModels.AceptarDocumentosLegalesModel

@{
    ViewData["Title"] = "Términos y Privacidad";
}

<div class="surface-card p-4" style="max-width:560px;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
    }

    <p>
        Para usar el sistema tenés que revisar y aceptar los documentos que rigen el servicio.
        Se abren en una pestaña nueva para no perder esta pantalla.
    </p>

    <p class="legal-meta">
        Versión @DocumentosLegales.VersionVigente &middot;
        Última actualización: @DocumentosLegales.FechaUltimaActualizacion
    </p>

    <ul>
        <li><a asp-controller="Home" asp-action="Terminos" target="_blank" rel="noopener">Términos de Servicio</a></li>
        <li><a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">Política de Privacidad</a></li>
    </ul>

    <form asp-action="AceptarDocumentosLegales">
        @* La versión viaja con el formulario: si se publicó una versión nueva mientras esta
           pantalla estaba abierta, la API rechaza la aceptación en vez de dar por aceptado
           un texto que el usuario no vio. *@
        <input type="hidden" asp-for="Version" />

        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" asp-for="Acepto" />
            <label class="form-check-label" asp-for="Acepto">
                He leído y acepto los Términos de Servicio y la Política de Privacidad.
            </label>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn-pa btn-pa-primary">Aceptar y continuar</button>
        </div>
    </form>
</div>
