@model Web.Models.Modelo_Configuracion.ConfiguracionModel

@{
    ViewData["Title"] = "Configuración";
    var sinLogo = string.IsNullOrWhiteSpace(Model.LogoUrl);
}

<div class="page-header">
    <p class="text-muted">Parámetros generales del sistema. Los cambios aplican para todos los usuarios.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="form-wrap">
        <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
    </div>
}

<div class="form-wrap">
    @* Los formularios no se anidan: el botón "Quitar" vive en la tarjeta
       y se asocia a este form por el atributo form=. *@
    <form asp-action="QuitarLogo" method="post" id="form-quitar-logo" hidden></form>

    <form asp-action="Index" enctype="multipart/form-data">
        <input type="hidden" asp-for="LogoUrl" />

        <div class="surface-card p-4 mb-3">
            <div class="ctitle">Identidad de la empresa</div>
            <p class="cdesc">Aparece en el menú lateral, en el título de cada pantalla y en la moneda de todos los importes.</p>

            <div class="logo-row">
                <div class="logo-box @(sinLogo ? "is-empty" : null)">
                    @if (!sinLogo)
                    {
                        <img src="@Model.LogoUrl" alt="Logo de @Model.NombreEmpresa" />
                    }
                    else
                    {
                        @await Html.PartialAsync("_Icon", "image")
                    }
                </div>
                <div class="logo-body">
                    <label for="logo">Logo de la empresa</label>
                    <input type="file" id="logo" name="logo" class="form-control" accept=".jpg,.jpeg,.png,.webp" data-max-mb="5" />
                    <div class="text-muted" style="font-size:.76rem; margin-top:5px;">
                        PNG, JPG o WEBP cuadrado, hasta 5 MB. Se guarda en el almacenamiento de imágenes del sistema; no se admiten enlaces externos.
                    </div>
                    <span class="text-danger small d-block" data-imagen-error></span>
                    @if (!sinLogo)
                    {
                        <div class="logo-acts">
                            <button type="submit" form="form-quitar-logo" class="btn-pa btn-pa-danger">
                                @await Html.PartialAsync("_Icon", "trash") Quitar
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="fgrid">
                <div>
                    <label asp-for="NombreEmpresa">Nombre de la empresa</label>
                    <input asp-for="NombreEmpresa" class="form-control" />
                    <span asp-validation-for="NombreEmpresa" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Moneda">Moneda</label>
                    <select asp-for="Moneda" class="form-select">
                        <option value="USD">USD — Dólar estadounidense</option>
                        <option value="DOP">DOP — Peso dominicano</option>
                        <option value="EUR">EUR — Euro</option>
                        <option value="MXN">MXN — Peso mexicano</option>
                    </select>
                    <span asp-validation-for="Moneda" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="RucONit">RNC / RUC / NIT</label>
                    <input asp-for="RucONit" class="form-control mono" />
                    <div class="text-muted" style="font-size:.76rem; margin-top:5px;">
                        Aparece bajo el nombre en la factura.
                    </div>
                    <span asp-validation-for="RucONit" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Direccion">Dirección</label>
                    <input asp-for="Direccion" class="form-control" />
                    <div class="text-muted" style="font-size:.76rem; margin-top:5px;">
                        Una sola línea, tal como debe imprimirse.
                    </div>
                    <span asp-validation-for="Direccion" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="surface-card p-4 mb-3">
            <div class="ctitle">Sesión</div>
            <p class="cdesc">Cuánto dura activa una sesión antes de pedir volver a iniciar sesión.</p>
            <div class="fgrid">
                <div>
                    <label asp-for="DuracionTokenMinutos">Duración del token (minutos)</label>
                    <input asp-for="DuracionTokenMinutos" type="number" min="1" class="form-control mono" />
                    <div class="text-muted" style="font-size:.76rem; margin-top:5px;">
                        Si no hay configuración cargada, el sistema usa 60 minutos.
                    </div>
                    <span asp-validation-for="DuracionTokenMinutos" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="surface-card p-4 mb-3">
            <div class="ctitle">Inventario</div>
            <p class="cdesc">Umbral por defecto a partir del cual un producto se marca en stock bajo.</p>
            <div class="fgrid">
                <div>
                    <label asp-for="CantidadMinimaInventarioDefecto">Cantidad mínima de inventario por defecto</label>
                    <input asp-for="CantidadMinimaInventarioDefecto" type="number" min="0" class="form-control mono" />
                    <div class="text-muted" style="font-size:.76rem; margin-top:5px;">
                        Se puede sobrescribir producto por producto desde Inventario. Valor de respaldo: 5 unidades.
                    </div>
                    <span asp-validation-for="CantidadMinimaInventarioDefecto" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="factions">
            <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "reset") Descartar</a>
            <button type="submit" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "check") Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
