@model Web.Models.Modelo_Proveedores.ProveedorModels.CreateProveedorModel

@{
    ViewData["Title"] = "Nuevo proveedor";
}

<div class="crumb">
    <a asp-action="Index">Proveedores</a>
    @await Html.PartialAsync("_Icon", "chevron-right")
    <span>Nuevo proveedor</span>
</div>

<div class="page-header">
    <div>
        <h1>Nuevo proveedor</h1>
        <p class="text-muted">Se usará para asignarle productos y revisar su stock bajo.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="form-wrap">
        <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
    </div>
}

<div class="form-wrap">
    <form asp-action="Create">
        <div class="fsec">
            <div class="stitle">Datos del proveedor</div>
            <div class="fgrid">
                <div class="ffull">
                    <label asp-for="Nombre">Nombre o razón social</label>
                    <input asp-for="Nombre" class="form-control" placeholder="ej. Distribuidora Ferretera del Caribe" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Correo">Correo electrónico</label>
                    <input asp-for="Correo" class="form-control" placeholder="ventas@proveedor.com" />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Telefono">Teléfono</label>
                    <input asp-for="Telefono" class="form-control mono" placeholder="8091234567" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="fsec">
            <div class="stitle">Dirección</div>
            <div class="fgrid">
                <div class="ffull">
                    <label asp-for="Direccion">Dirección</label>
                    <input asp-for="Direccion" class="form-control" placeholder="ej. Av. Duarte 120, Santiago" />
                    <span asp-validation-for="Direccion" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="factions">
            <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "back") Volver</a>
            <button type="submit" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "check") Guardar proveedor</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
