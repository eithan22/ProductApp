@model Web.Models.Modelo_Proveedores.ProveedorModels.ProveedorModel

@{
    ViewData["Title"] = "Detalle de proveedor";
}

<div class="surface-card p-4" style="max-width:680px;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
            <span class="mono text-muted" style="font-size:.8rem;">#@Model.Id</span>
            <h2 class="mt-1 mb-0">@Model.Nombre</h2>
        </div>
        <span class="status-pill @(Model.Activo ? "on" : "off")">
            <span class="dot"></span> @(Model.Activo ? "Activo" : "Inactivo")
        </span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label d-block">Correo</label>
            <div>@Model.Correo</div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label d-block">Teléfono</label>
            <div class="mono">@Model.Telefono</div>
        </div>
        <div class="col-12 mb-3">
            <label class="form-label d-block">Dirección</label>
            <div>@Model.Direccion</div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-2">
        <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "back") Volver</a>
        <div class="d-flex gap-2">
            @* Atajo al stock bajo de este proveedor: es la razón principal por la que
               se abre la ficha durante una reposición. *@
            <a asp-controller="Inventario" asp-action="StockBajo" asp-route-proveedorId="@Model.Id" class="btn-pa btn-pa-outline">
                @await Html.PartialAsync("_Icon", "layers") Ver su stock bajo
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "edit") Editar</a>
        </div>
    </div>
</div>
