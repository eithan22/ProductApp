@model Web.Models.ClienteModels.CreateClienteModel

@{
    ViewData["Title"] = "Nuevo cliente";
}

<div class="crumb">
    <a asp-action="Index">Clientes</a>
    @await Html.PartialAsync("_Icon", "chevron-right")
    <span>Nuevo cliente</span>
</div>

<div class="page-header">
    <div>
        <h1>Nuevo cliente</h1>
        <p class="text-muted">Se usará para asociarle órdenes y llevar su historial de compras.</p>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="form-wrap">
        <div class="alert alert-danger"><div asp-validation-summary="All"></div></div>
    </div>
}

<div class="form-wrap">
    <form asp-action="Create">
        <div class="fsec">
            <div class="stitle">Datos del cliente</div>
            <div class="fgrid">
                <div class="ffull">
                    <label asp-for="Nombre">Nombre completo o razón social</label>
                    <input asp-for="Nombre" class="form-control" placeholder="ej. Constructora Ferreira SRL" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Correo">Correo electrónico</label>
                    <input asp-for="Correo" class="form-control" placeholder="compras@empresa.com" />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Telefono">Teléfono</label>
                    <input asp-for="Telefono" class="form-control mono" placeholder="8091234567" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="Cedula">Cédula o RNC</label>
                    <input asp-for="Cedula" class="form-control mono" placeholder="40212345678" />
                    <span asp-validation-for="Cedula" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="fsec">
            <div class="stitle">Dirección</div>
            <div class="fgrid">
                <div class="ffull">
                    <label asp-for="Direccion">Dirección</label>
                    <input asp-for="Direccion" class="form-control" placeholder="ej. Av. Independencia 452, Santo Domingo" />
                    <span asp-validation-for="Direccion" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="factions">
            <a asp-action="Index" class="btn-pa btn-pa-outline">@await Html.PartialAsync("_Icon", "back") Volver</a>
            <button type="submit" class="btn-pa btn-pa-primary">@await Html.PartialAsync("_Icon", "check") Guardar cliente</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
